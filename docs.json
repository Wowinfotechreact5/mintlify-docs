{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Valuez AI",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": {
